# Laravel API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000/api

# Google Maps. These end up in the public JS bundle, so secure the key in Google Cloud:
# restrict it to your HTTP referrers (localhost:5173, your Vercel domain) and to the
# Maps JavaScript API only, and set a budget alert.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (JavaScript, vector) from Google Maps Platform > Map Management. Required for Advanced Markers.
VITE_GOOGLE_MAPS_MAP_ID=
